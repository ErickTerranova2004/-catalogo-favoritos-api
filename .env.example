# Copia este archivo como .env y reemplaza los valores. NUNCA subas .env al repositorio.

# Puerto del servidor
PORT=3000

# Conexión a PostgreSQL: postgres://USUARIO:CLAVE@HOST:PUERTO/BASE
DATABASE_URL=postgres://postgres:tu_clave@localhost:5432/catalogo_db

# Secreto para firmar los JWT (mínimo 32 caracteres, aleatorio).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=reemplaza_por_un_secreto_largo_y_aleatorio_de_al_menos_32_caracteres

# Tiempo de vida del token (formato: 60, "15m", "1h", "1d")
JWT_EXPIRES_IN=1h

# Costo del hash bcrypt
BCRYPT_ROUNDS=10

# Datos del administrador inicial (los usa: npm run admin:crear)
ADMIN_NOMBRE=Administrador
ADMIN_EMAIL=admin@catalogo.local
ADMIN_PASSWORD=cambia_esta_clave
